{
  "name": "airas-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && npx -y wrangler pages deploy dist --project-name airas-world",
    "deploy:firebase": "npm run build && npx -y firebase-tools deploy",
    "deploy:gh-pages": "npm run build && npx -y gh-pages -d dist",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.16.0",
    "peerjs": "^1.5.5",
    "pixi.js": "^8.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.131.0"
  }
}
